# The SEC requires a descriptive User-Agent containing a real contact address.
# Requests without one are blocked. Copy this file to .env and fill it in.
EDGAR_USER_AGENT="Your Name your.address@example.org"

# Where raw responses are cached. Never committed.
EDGAR_CACHE_ROOT=data/raw

# Requests per second. The SEC fair-access ceiling is 10; lower is polite.
EDGAR_RATE_PER_SECOND=8

# Postgres, as started by docker-compose.yml. Tests that need a database
# skip when this is unset.
DATABASE_URL=postgresql://firmdirector:firmdirector@localhost:5432/firmdirector
